{
  "headers": [
    {
      "source": "/(version\\.json|sw\\.js|workbox-.*\\.js|registerSW\\.js|workspace-manifest\\.json|index\\.html|workspace\\.html|workspace-lousa\\.html|workspace-aulas-video\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "workspace.sistemaptt.com.br"
        }
      ],
      "destination": "/workspace",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.sistemaptt.com.br/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/matricula",
      "destination": "/matricula.html"
    },
    {
      "source": "/hub-matriculas",
      "destination": "/hub-matriculas.html"
    },
    {
      "source": "/matricula-online",
      "destination": "/matricula-online.html"
    },
    {
      "source": "/workspace",
      "destination": "/workspace.html"
    },
    {
      "source": "/workspace-lousa",
      "destination": "/workspace-lousa.html"
    },
    {
      "source": "/workspace-aulas-video",
      "destination": "/workspace-aulas-video.html"
    }
  ]
}
{
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "workspace.sistemaptt.com.br"
        }
      ],
      "dest": "/workspace.html",
      "continue": true
    },
    {
      "src": "^/(|version\\.json|sw\\.js|workbox-.*\\.js|registerSW\\.js|workspace-manifest\\.json|index\\.html|workspace(\\.html)?|workspace-lousa(\\.html)?|workspace-aulas-video(\\.html)?)$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.sistemaptt.com.br/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin.html"
    },
    {
      "src": "^/matricula/?$",
      "dest": "/matricula.html"
    },
    {
      "src": "^/hub-matriculas/?$",
      "dest": "/hub-matriculas.html"
    },
    {
      "src": "^/matricula-online/?$",
      "dest": "/matricula-online.html"
    },
    {
      "src": "^/workspace/?$",
      "dest": "/workspace.html"
    },
    {
      "src": "^/workspace-lousa/?$",
      "dest": "/workspace-lousa.html"
    },
    {
      "src": "^/workspace-aulas-video/?$",
      "dest": "/workspace-aulas-video.html"
    }
  ]
}